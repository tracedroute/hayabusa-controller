!
! Aruba AOS-CX ZTP Configuration
! For AOS-CX 6000, 6100, 6200, 6300, 6400, 8000, 83xx series
!
configure terminal
hostname Aruba-AOS-CX
!
interface mgmt
 ip address 192.168.2.50/24
 ip gateway 192.168.2.1
 ip dns 8.8.8.8
!
interface 1/1/1
 description Data-Port-1
 no shutdown
!
interface 1/1/2
 description Data-Port-2
 no shutdown
!
user admin
 password admin123
 role network-admin
!
ssh public-key-authentication
ssh server allow-insecure-ciphers
ssh server port 22
ssh enable
!
spanning-tree rstp enable
spanning-tree priority 32768
!
end
write memory
