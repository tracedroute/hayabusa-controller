{
  "device_type": "switch",
  "vendor": "aruba",
  "config_template": "aos-s",
  "pnp_server": "pnpserver.local",
  "tftp_root": "/var/lib/peregrine/ztp/tftp",
  "configuration": {
    "hostname": "aruba-aos-s-ztp",
    "interfaces": [
      {
        "name": "1/1/1",
        "description": "Access",
        "vlan": 10
      },
      {
        "name": "1/1/24",
        "description": "Uplink trunk",
        "mode": "trunk"
      }
    ],
    "vlans": [
      {
        "id": 10,
        "name": "data"
      }
    ],
    "services": {
      "ssh": {
        "enabled": true
      },
      "https": {
        "enabled": true
      }
    }
  },
  "model": "AOS-S"
}
