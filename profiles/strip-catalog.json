{
  "version": 2,
  "description": "Offline AppX/path deletes inside install.wim for Windows client and Server (Desktop Experience). Paths are globs matched against WindowsApps before delete. Server Core often has no matches — that is expected.",
  "category_order": ["Xbox", "Media", "Bing", "Productivity", "Games", "Support", "Server"],
  "presets": [
    {
      "id": "recommended",
      "label": "Recommended",
      "description": "Defaults for the detected OS family (client or Server)",
      "use_defaults": true
    },
    {
      "id": "recommended-client",
      "label": "Recommended (Windows client)",
      "description": "Consumer bloat trim for Win10/Win11",
      "applies_to": ["client"],
      "use_defaults": true
    },
    {
      "id": "recommended-server",
      "label": "Recommended (Windows Server)",
      "description": "Safe inbox AppX trim for Server Desktop Experience",
      "applies_to": ["server"],
      "categories": ["Xbox", "Media", "Bing", "Games", "Support"]
    },
    {
      "id": "remove-all",
      "label": "Remove all",
      "description": "Select every catalog item that applies to this OS",
      "option_ids": ["*"]
    },
    {
      "id": "xbox-only",
      "label": "Xbox bundle",
      "description": "Remove only Xbox-related packages",
      "categories": ["Xbox"]
    },
    {
      "id": "none",
      "label": "Keep everything",
      "description": "Bank WIM without removing apps",
      "option_ids": []
    }
  ],
  "options": [
    {
      "id": "xbox-app",
      "label": "Xbox App",
      "category": "Xbox",
      "applies_to": ["client", "server"],
      "description": "Main Xbox companion application",
      "wim_path": "\\Program Files\\WindowsApps\\Microsoft.XboxApp_*",
      "default_enabled": true
    },
    {
      "id": "xbox-tcui",
      "label": "Xbox TCUI",
      "category": "Xbox",
      "applies_to": ["client", "server"],
      "description": "Xbox title-call UI shell",
      "wim_path": "\\Program Files\\WindowsApps\\Microsoft.Xbox.TCUI_*",
      "default_enabled": true
    },
    {
      "id": "xbox-game-overlay",
      "label": "Xbox Game Overlay",
      "category": "Xbox",
      "applies_to": ["client"],
      "description": "In-game overlay and capture UI",
      "wim_path": "\\Program Files\\WindowsApps\\Microsoft.XboxGameOverlay_*",
      "default_enabled": true
    },
    {
      "id": "xbox-gaming-overlay",
      "label": "Xbox Gaming Overlay",
      "category": "Xbox",
      "applies_to": ["client", "server"],
      "description": "Gaming bar / Game Bar overlay package",
      "wim_path": "\\Program Files\\WindowsApps\\Microsoft.XboxGamingOverlay_*",
